# LLM used for fit scoring and company research. Copy to `.env` and fill in.
# Works with any OpenAI-compatible API:
#   scoring  -> POST {LLM_BASE_URL}/chat/completions
#   research -> POST {LLM_BASE_URL}/responses with the built-in "web_search" tool
#               (needs a provider whose Responses API offers web search)
# Examples of LLM_BASE_URL: https://api.openai.com/v1, https://api.meta.ai/v1

LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Optional
# LLM_REASONING_EFFORT=low     # only for reasoning models; left out of requests when blank
# LLM_TIMEOUT_S=180
# LLM_CONCURRENCY=3

# User-Agent sent to every site we scrape.
# JOBHUNT_USER_AGENT=Mozilla/5.0 (compatible; JobHuntPA/1.0; personal job search tool)
