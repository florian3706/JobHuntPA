# LLM used for fit scoring, cover letters, job-title suggestions, company research and job chat.
# Copy to `.env` and fill in (setup does this for you).
# Works with any OpenAI-compatible API:
#   scoring, cover letters, chat -> POST {LLM_BASE_URL}/chat/completions
#   research, chat with web search -> POST {LLM_BASE_URL}/responses with the built-in "web_search"
#               tool (needs a provider whose Responses API offers web search)
# Examples of LLM_BASE_URL: https://api.openai.com/v1, https://api.meta.ai/v1

LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Optional
# Reasoning level per task (scoring, cover letters, research) is set in the app:
# Search setup > LLM. This is only the fallback when a task is left on "Model default".
# LLM_REASONING_EFFORT=low
# LLM_TIMEOUT_S=180
# LLM_CONCURRENCY=3

# Commute times on each job's page (optional; leave blank to skip):
#   public transport -> Transport for NSW Trip Planner API (free key: https://opendata.transport.nsw.gov.au)
#   driving in peak traffic -> TomTom Routing API (free key: https://developer.tomtom.com);
#   without it, driving times come from OSRM's public server and ignore traffic.
TFNSW_API_KEY=
TOMTOM_API_KEY=

# User-Agent sent to every site we scrape.
# JOBHUNT_USER_AGENT=Mozilla/5.0 (compatible; JobHuntPA/1.0; personal job search tool)
