# LLM used for fit scoring, cover letters, job-title suggestions, company research and job chat.
# Copy to `.env` and fill in (setup does this for you). The same three values can be set in the app,
# in the Settings tab (AI provider; pick a provider, type the model, paste the key), which rewrites these lines.
# The address picks how the app talks to the provider:
#   most providers are OpenAI-compatible:
#     scoring, cover letters, chat -> POST {LLM_BASE_URL}/chat/completions
#     research, chat with web search -> POST {LLM_BASE_URL}/responses with the built-in "web_search"
#                 tool (needs a provider whose Responses API offers web search)
#   api.anthropic.com (Claude) and generativelanguage.googleapis.com (Gemini) are called their own way
# Examples of LLM_BASE_URL (LLM_MODEL is the provider's model id, e.g. gpt-6-luna or claude-opus-5-5):
#   OpenAI      https://api.openai.com/v1
#   Anthropic   https://api.anthropic.com
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai
#   Meta        https://api.meta.ai/v1
#   Mistral     https://api.mistral.ai/v1
#   Groq        https://api.groq.com/openai/v1
#   xAI (Grok)  https://api.x.ai/v1
#   DeepSeek    https://api.deepseek.com
#   OpenRouter  https://openrouter.ai/api/v1
#   Ollama      http://localhost:11434/v1   (runs on your computer; leave LLM_API_KEY empty)
#   any other OpenAI-compatible service: its base URL
# Mistral, Groq, DeepSeek and Ollama have no web search through this app, so company research,
# finding offices and the chat's "Search the web" don't work with them; everything else does.

LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Optional
# Reasoning level per task (scoring, cover letters, research) is set in the app:
# the Settings tab (AI provider). This is only the fallback when a task is left on "Model default".
# LLM_REASONING_EFFORT=low
# LLM_TIMEOUT_S=180
# LLM_CONCURRENCY=3

# Scheduled searches (Settings > Scheduled searches) run while the app is running.
# Set to off when a second copy of the app shares the same data and the other copy runs them.
# JOBHUNT_SCHEDULER=on

# User-Agent sent to every site we scrape.
# JOBHUNT_USER_AGENT=Mozilla/5.0 (compatible; JobHuntPA/1.0; personal job search tool)

# Encryption keys (optional; most installs never set these).
# How much work protects each password: default, or low for a slow device such as a Raspberry Pi 3 or Zero 2 W.
# To see how long sign-in takes on this computer: python -m backend.keys bench-kdf
# JOBHUNT_KDF_PROFILE=default
# Where the server's key file is kept. It must stay with the database: back them up together.
# JOBHUNT_KEY_FILE=data/server-keys.json

# The account. JobHuntPA has one: the first time it starts, it asks in the browser for a name and a password (the
# address is also printed, and the one-time code is in data/first-run.txt). Once it exists, no other can be made.
# For CI or a headless server, it can instead be created at start-up from these two variables (the first holds the
# name; the variable names are older than that). They are read from the process environment only (export them, or
# set them in the service definition), never from this file: don't store the password here.
#   JOBHUNT_ADMIN_EMAIL=your name
#   JOBHUNT_ADMIN_PASSWORD=at least 10 characters
# Lost the password and every recovery code? Stop JobHuntPA and run the reset tool (./reset.sh): it deletes the
# account and its data and keeps this file.

# The address other devices use to reach JobHuntPA, when it is behind an HTTPS proxy on this computer (for example
# the https:// name `tailscale serve` gives it): sign-in cookies are then marked Secure, and pages at that address
# are accepted. No trailing slash, query or fragment; http only for localhost. Set it in the app (Settings > Public
# address and host names), which rewrites this line, or here (then restart JobHuntPA).
# PUBLIC_BASE_URL=https://jobs.example.com
# More host names the app answers to, comma-separated, no spaces (IP addresses always work). Also in that card.
# JOBHUNT_ALLOWED_HOSTS=jobs.example.com,pi.tail1234.ts.net

# Names other than an IP address, localhost, this computer's own names and PUBLIC_BASE_URL's host that people use to
# reach JobHuntPA (for example the name `tailscale serve` or a reverse proxy passes on). A request for any other name
# gets "This address isn't allowed" (a defence against DNS rebinding). Comma-separated host names only: no http://,
# port or path. Restart JobHuntPA after changing it.
# JOBHUNT_ALLOWED_HOSTS=jobs.example.com,pi.tail1234.ts.net
