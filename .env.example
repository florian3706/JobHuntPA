# Muse Spark fit scorer — copy to `.env` and fill in.
# Client POSTs OpenAI-compatibly to {MUSE_SPARK_BASE_URL}/chat/completions
# with `Authorization: Bearer <key>` per spec.
#
# Key resolution (primary → fallback):
#   1. MODEL_API_KEY (primary, Bearer per spec)
#   2. MUSE_SPARK_API_KEY (fallback, backwards-compat)
# Placeholders only here — put real keys in `.env` (never commit).
MODEL_API_KEY=
MUSE_SPARK_API_KEY=

# Default base when unset: https://api.meta.ai/v1
# Override for proxies/mocks/regional endpoints, e.g. http://localhost:8080/v1
MUSE_SPARK_BASE_URL=https://api.meta.ai/v1

# Default model when unset: muse-spark-1.3-contributor
# Valid models — standard: muse-spark-1.3 / muse-spark-1.2 / muse-spark-1.1;
#   contributor: muse-spark-1.3-contributor / muse-spark-1.2-contributor.
MUSE_SPARK_MODEL=muse-spark-1.3-contributor

# Context window: 1048576 tokens (1M). Long job descriptions + CV/profile
# text are truncated client-side to fit this budget.
