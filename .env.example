# Muse Spark fit scorer (Meta Model API). Copy to `.env` and fill in.
# Docs: https://dev.meta.ai/docs/protocols/chat-completions

# API key from the Meta Model API dashboard (MUSE_SPARK_API_KEY also works).
MODEL_API_KEY=

# Defaults shown; uncomment to override.
# MUSE_SPARK_BASE_URL=https://api.meta.ai/v1
# Contributor models are cheaper but Meta may train on prompts, which
# include your uploaded documents. Standard: muse-spark-1.3
# MUSE_SPARK_MODEL=muse-spark-1.3-contributor
# minimal | low | medium | high | xhigh
# MUSE_SPARK_REASONING_EFFORT=low
# MUSE_SPARK_TIMEOUT_S=180
# MUSE_SPARK_CONCURRENCY=3

# User-Agent sent to every site we scrape.
# JOBHUNT_USER_AGENT=Mozilla/5.0 (compatible; JobHuntPA/1.0; personal job search tool)
